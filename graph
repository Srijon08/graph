bool dfsMaze(vector<vector<int>> &maze, int r, int c,

             vector<pair<int, int>> &path, vector<vector<bool>> &visited)
{

    int rows = maze.size(), cols = maze[0].size();
    if (r < 0 || r >= rows || c < 0 || c >= cols)
        return false;
    if (maze[r][c] == 0 || visited[r][c])
        return false;
    visited[r][c] = true;
    path.push_back({r, c});
    if (r == rows - 1 && c == cols - 1)
        return true;
    int dr[] = {1, 0, -1, 0};
    int dc[] = {0, 1, 0, -1};
    for (int d = 0; d < 4; d++)
        if (dfsMaze(maze, r + dr[d], c + dc[d], path, visited))
            return true;

    path.pop_back();
    return false;
}
vector<pair<int, int>> solveMaze(vector<vector<int>> &maze)
{
    int rows = maze.size(), cols = maze[0].size();
    vector<pair<int, int>> path;
    vector<vector<bool>> visited(rows, vector<bool>(cols, false));
    dfsMaze(maze, 0, 0, path, visited);
    return path;
}

dfsTreasure(vector<vector<int>> &maze, int r, int c,
            vector<pair<int, int>> &path, vector<vector<bool>> &visited)
{

    int rows = maze.size(), cols = maze[0].size();
    if (r < 0 || r >= rows || c < 0 || c >= cols)
        return false;
    if (visited[r][c] || maze[r][c] == 1)
        return false;
    visited[r][c] = true;
    path.push_back({r, c});
    if (maze[r][c] == 999)
        return true;
    int dc[] = {0, 0, 1, -1};
    for (int d = 0; d < 4; d++)
        if (dfsTreasure(maze, r + dr[d], c + dc[d], path, visited))
            return true;

    path.pop_back();
    return false;
}
vector<pair<int, int>> findTreasure(vector<vector<int>> &maze)
{
    int rows = maze.size(), cols = maze[0].size();
    vector<pair<int, int>> path;
    vector<vector<bool>> visited(rows, vector<bool>(cols, false));
    dfsTreasure(maze, 0, 0, path, visited);
