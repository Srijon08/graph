bool dfsWord(vector<vector<char>> &grid, const string &word,

             int r, int c, int idx)
{

    if (idx == (int)word.size())
        return true;
    int rows = grid.size(), cols = grid[0].size();
    if (r < 0 || r >= rows || c < 0 || c >= cols || grid[r][c] != word[idx])
        return false;
    char temp = grid[r][c];
    grid[r][c] = ’#’;
    bool found = dfsWord(grid, word, r + 1, c, idx + 1) ||
                 dfsWord(grid, word, r - 1, c, idx + 1) ||
                 dfsWord(grid, word, r, c + 1, idx + 1) ||
                 dfsWord(grid, word, r, c - 1, idx + 1);

    grid[r][c] = temp; // Restore cell
    return found;
}
bool wordSearch(vector<vector<char>> &grid, const string &word)
{
    for (int r = 0; r < (int)grid.size(); r++)
        for (int c = 0; c < (int)grid[0].size(); c++)
            if (dfsWord(grid, word, r, c, 0))
                return true;

    return false;
}

void dfsTopoSort(int node, vector<vector<int>> &adj,
                 vector<bool> &visited, stack<int> &stk)
{

    visited[node] = true;
    for (int neighbor : adj[node])
        if (!visited[neighbor])
            dfsTopoSort(neighbor, adj, visited, stk);

    stk.push(node);
}
